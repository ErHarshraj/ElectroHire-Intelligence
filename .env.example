# ElectroHire Intelligence - Environment Configuration

# Application
APP_NAME=ElectroHire Intelligence
APP_ENV=development
APP_DEBUG=false

# API
API_HOST=127.0.0.1
API_PORT=8000

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=electrohire
POSTGRES_USER=electrohire
POSTGRES_PASSWORD=CHANGE_ME

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Security
SECRET_KEY=CHANGE_ME

# AI / LLM
LLM_ENABLED=false
LLM_API_KEY=

# Notifications
EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=

# Logging
LOG_LEVEL=INFO
