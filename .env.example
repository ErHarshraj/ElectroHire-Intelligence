# ElectroHire Intelligence - Environment Configuration

# Application
APP_NAME=ElectroHire Intelligence
APP_ENV=development
APP_DEBUG=false

# API
API_HOST=127.0.0.1
API_PORT=8000

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=electrohire
POSTGRES_USER=electrohire
POSTGRES_PASSWORD=CHANGE_ME

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Security
SECRET_KEY=CHANGE_ME

# AI / LLM
LLM_ENABLED=false
LLM_API_KEY=

# Notifications
EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=

# Scheduler
SCHEDULER_DISCOVERY_INTERVAL_MINUTES=60
SCHEDULER_RECOVERY_INTERVAL_MINUTES=30

# Logging
LOG_LEVEL=INFO

# Browser Automation
# Disabled by default.
# Application execution mode: DRY_RUN, APPROVAL_REQUIRED, or FULL_AUTO.
# DRY_RUN is the safe default. FULL_AUTO enables unattended submission after safety checks.
APPLICATION_EXECUTION_MODE=DRY_RUN

BROWSER_ENABLED=false
BROWSER_HEADLESS=true
BROWSER_TIMEOUT_MS=15000
# Leave empty to automatically detect Chromium.
BROWSER_EXECUTABLE_PATH=


# Lever public career boards
# Format: Company Name:site
LEVER_BOARDS=[]

# Ashby public career boards
# Format: Company Name:board-name
ASHBY_BOARDS=[]

# SmartRecruiters public career boards
# Format: Company Name:company-identifier
SMARTRECRUITERS_BOARDS=[]
